{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trikal-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "trikal_api.app:app", "--app-dir", "api", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "trikal-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    }
  ]
}
